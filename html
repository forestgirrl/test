    openQ1Image(target.dataset.q1FullImage, target.dataset.q1Alt, target.dataset.q1Heading, target.dataset.q1Description);
  }

  let q1ImageCloseTimer = null;
  let q1ImageIntroTimer = null;
  let q1ImageClosing = false;
  let q1ImageCloseAnimating = false;
  let q1ImageIntroRevealed = false;
  let q1ImageGeometry = null;
  function syncQ1ImageGeometry() {
    const detailVisual = document.querySelector('.q1-image-project-visual');
    const detailCopy = document.querySelector('.q1-image-project-copy');
    const copy = document.querySelector('.q1-image-copy');
    if (!detailVisual || !detailCopy || !copy) return false;
    const visualRect = detailVisual.getBoundingClientRect();
    const copyRect = detailCopy.getBoundingClientRect();
    if (!visualRect.width || !copyRect.width) return false;
    const compactSize = window.innerWidth <= 760
      ? Math.min(window.innerHeight * .48, window.innerWidth * .42, 300)
      : Math.min(window.innerHeight * .62, window.innerWidth * .48, 640);
    q1ImageGeometry = {
      compactSize,
      targetLeft: (visualRect.left + visualRect.width / 2) / Math.max(window.innerWidth, 1) * 100,
      copyLeft: copyRect.left,
      copyWidth: copyRect.width
    };
    copy.style.left = `${q1ImageGeometry.copyLeft}px`;
    copy.style.width = `${q1ImageGeometry.copyWidth}px`;
    return true;
  }
  function updateQ1ImageScroll() {
    const page = document.getElementById('q1-image-page');
    const scene = document.getElementById('q1-image-scene');
    const visual = document.querySelector('.q1-image-visual');
    const copy = document.querySelector('.q1-image-copy');
    const hint = document.getElementById('q1-image-scroll-hint');
    if (!page || !scene || !visual || !copy || !hint) return;
    const scrollProgress = Math.min(1, Math.max(0, page.scrollTop / Math.max(window.innerHeight, 1)));
    const rawProgress = Math.max(scrollProgress, q1ImageIntroRevealed ? 1 : 0);
    const progress = rawProgress * rawProgress * (3 - 2 * rawProgress);
    const sceneFade = Math.min(1, Math.max(0, (scrollProgress - .88) / .12));
    const fadeProgress = sceneFade * sceneFade * (3 - 2 * sceneFade);
  const startSize = Math.max(window.innerWidth, window.innerHeight) * 1.45;
  const isCompactViewport = window.innerWidth <= 760;
  const fallbackSize = isCompactViewport
    ? Math.min(window.innerHeight * .48, window.innerWidth * .42, 300)
