<script id="q2-vi-image-area-removal">
(()=>{
  const setup=()=>{
    const dialog=document.querySelector('.q2-tool-detail-dialog');
    if(!dialog)return;
    const sync=()=>{
      const title=dialog.querySelector('h1,h2,h3,[class*="title"]');
      dialog.classList.toggle('is-vi-tool',/VI\s*轉活動彈窗/i.test((title?.textContent||'').trim()));
    };
    sync();
    new MutationObserver(sync).observe(dialog,{subtree:true,childList:true,characterData:true});
    document.addEventListener('click',()=>requestAnimationFrame(sync),true);
  };
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',setup,{once:true});else setup();
})();
