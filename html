    workflowDescription: '依照原廠視覺規範快速產出彈窗，縮短修改流程，靈活因應需求變動。',
    points: ['製作技能工具', '簡化素材產出', '加快需求對焦', '支援與騰訊溝通'],
    highlightTitle: 'PSD 自動轉存效果圖',
    highlight: '一鍵產出完整效果圖，省去手動編排，方便與原廠對接。'
    },
    {
      title: '拍臉圖',
      lead: '',
      pointTitle: '', points: [],
      highlightTitle: '', highlight: ''
    }
  ];

  let q1DetailReturnTarget = null;
  let q1DetailCloseTimer = null;
  const q1DetailOverlayElement = document.getElementById('q1-detail-overlay');
  q1DetailOverlayElement.addEventListener('click', (event) => {
    if (event.target === q1DetailOverlayElement && q1DetailOverlayElement.classList.contains('is-modal')) closeQ1Detail();
  });
  const q1GalleryCards = [...document.querySelectorAll('[data-q1-gallery-index]')];
  const q1GalleryPositionClasses = ['is-active', 'is-next', 'is-far-next', 'is-far-prev', 'is-prev'];
  const q1GalleryIndices = { game: 0, offline: 0 };
  function getQ1GalleryCards(group) {
    return q1GalleryCards.filter((card) => card.dataset.q1GalleryGroup === group);
  }
  function renderQ1Gallery(group) {
    const cards = getQ1GalleryCards(group);
    const count = cards.length;
    const currentIndex = q1GalleryIndices[group] || 0;
    cards.forEach((card) => {
      const index = Number(card.dataset.q1GalleryIndex);
      const position = (index - currentIndex + count) % count;
      const positionClass = count === 3
        ? ['is-active', 'is-next', 'is-prev'][position]
        : q1GalleryPositionClasses[position];
      q1GalleryPositionClasses.forEach((name) => card.classList.toggle(name, name === positionClass));
      card.setAttribute('aria-current', position === 0 ? 'true' : 'false');
    });
  }
  function moveQ1Gallery(direction, group) {
    const cards = getQ1GalleryCards(group);
    const count = cards.length;
    if (!count) return;
    const wrapPosition = count === 3 ? (direction > 0 ? 2 : 1) : (direction > 0 ? 3 : 2);
    const currentIndex = q1GalleryIndices[group] || 0;
    const wrapCard = cards.find((card) => (Number(card.dataset.q1GalleryIndex) - currentIndex + count) % count === wrapPosition);
    if (wrapCard) wrapCard.classList.add('no-transition');
    q1GalleryIndices[group] = (currentIndex + direction + count) % count;
    renderQ1Gallery(group);
    if (wrapCard) {
      void wrapCard.offsetWidth;
      requestAnimationFrame(() => wrapCard.classList.remove('no-transition'));
    }
  }
  document.querySelectorAll('[data-q1-gallery-step]').forEach((button) => {
    button.addEventListener('click', () => moveQ1Gallery(Number(button.dataset.q1GalleryStep), button.dataset.q1GalleryGroup));
  });
  q1GalleryCards.forEach((button) => {
    button.addEventListener('click', () => openQ1Image(button.dataset.q1FullImage, button.dataset.q1Alt, button.dataset.q1Heading, button.dataset.q1Description));
  });

  const q1CollabComparison = document.getElementById('q1-detail-collab-comparison');
  if (q1CollabComparison) {
    const q1CollabRange = q1CollabComparison.querySelector('.q1-detail-collab-range');
    const setComparePosition = () => {
      const percent = Math.min(100, Math.max(0, Number(q1CollabRange.value)));
      q1CollabComparison.style.setProperty('--compare-p', `${percent}%`);
      q1CollabComparison.classList.add('is-interacted');
      q1CollabRange.setAttribute('aria-valuetext', `${Math.round(percent)}% 修改後`);
    };
    q1CollabRange.addEventListener('input', setComparePosition);
    q1CollabRange.addEventListener('change', setComparePosition);
  }

  function openQ1Detail(index, updateHistory = true) {
    const data = q1DetailData[index];
    const overlay = document.getElementById('q1-detail-overlay');
    if (!data || !overlay) return;
    window.clearTimeout(q1DetailCloseTimer);
    q1DetailCloseTimer = null;
    overlay.classList.remove('is-fading-out');
    q1DetailReturnTarget = document.activeElement;
    const number = String(index + 1).padStart(2, '0');
    const detailTitle = document.getElementById('q1-detail-title');
    detailTitle.textContent = data.title;
    const showExtraGallery = index === 4;
    detailTitle.classList.toggle('is-single-line', index === 1 || showExtraGallery);
    const detailLead = document.getElementById('q1-detail-lead');
    detailLead.textContent = data.lead;
    detailLead.hidden = showExtraGallery;
    const showAsModal = index < 4;
    overlay.classList.toggle('is-modal', showAsModal);
    document.querySelector('main').inert = showAsModal;
    document.getElementById('q1-detail-footer-number').textContent = number;
    const showGameGallery = index === 0;
    const showOfflineGallery = index === 1;
    const showGallery = showGameGallery || showOfflineGallery;
    overlay.classList.toggle('is-extra-project', showExtraGallery);
    document.getElementById('q1-detail-gallery').hidden = !showGameGallery;
    document.getElementById('q1-detail-gallery-offline').hidden = !showOfflineGallery;
    document.getElementById('q1-detail-extra-gallery').hidden = !showExtraGallery;
    document.getElementById('q1-detail-panels').hidden = showGallery || showExtraGallery;
    if (showGameGallery) {
      q1GalleryIndices.game = 0;
      renderQ1Gallery('game');
    }
    if (showOfflineGallery) {
      q1GalleryIndices.offline = 0;
      renderQ1Gallery('offline');
    }
    document.getElementById('q1-detail-point-title').textContent = data.pointTitle;
    document.getElementById('q1-detail-highlight-title').textContent = data.highlightTitle;
    document.getElementById('q1-detail-highlight').textContent = data.highlight;
    const pointList = document.getElementById('q1-detail-points');
    const panels = document.getElementById('q1-detail-panels');
    const isCollabLayout = index === 2;
    const pointPanel = panels.querySelector('.q1-detail-point');
    pointPanel.querySelector('.q1-detail-collab-comparison').hidden = !isCollabLayout;
    pointPanel.querySelector('h3').hidden = isCollabLayout;
const isWorkflowLayout = index === 3;
pointList.hidden = isCollabLayout || isWorkflowLayout;
const workflowCopy = document.getElementById('q1-detail-workflow-copy');
workflowCopy.hidden = !isWorkflowLayout;
workflowCopy.textContent = data.workflowDescription || '';
panels.classList.toggle('is-collab-layout', isCollabLayout);
panels.classList.toggle('is-workflow-layout', isWorkflowLayout);
    pointList.replaceChildren(...data.points.map((point) => {
      const item = document.createElement('li');
      item.textContent = point;
      return item;
    }));
    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    if (updateHistory) history.pushState({ q1Detail: index }, '', `#q1-detail-${index + 1}`);
    document.getElementById('q1-detail-close').focus();
  }

  function openQ1ProjectFromVenue(group, imageIndex) {
    const target = getQ1GalleryCards(group).find((card) => Number(card.dataset.q1GalleryIndex) === imageIndex);
