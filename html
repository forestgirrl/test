<script>
(() => {
  const copyByTitle = [
    ["VI轉活動彈窗", "今年遊戲內活動製作比例較高，每項活動通常需要製作多種類型與多頁彈窗，無論是否有既定 VI，都有大量頁面設計需求。因此，我製作此技能工具，協助快速產出彈窗的基礎架構，提升初期製作效率；當騰訊後續提出修改時，也能更快調整與更新。"],
    ["PSD自動轉存效果圖", "每項活動完成後，都需要整理效果圖提供騰訊校稿與確認。彈窗數量較多時，逐一編排效果圖會增加不少後製時間，因此我製作此技能工具，讓使用者匯入檔案後即可自動排版，減少手動整理的時間。"]
  ];
  const normalize = value => (value || "").replace(/\s/g, "");
  const findCard = title => {
    const headings = [...document.querySelectorAll("h1,h2,h3,h4,[role=heading],.q1-detail-workflow-title")];
    const heading = headings.find(el => normalize(el.textContent).includes(normalize(title)));
    if (!heading) return null;
    return heading.closest("article,.q1-detail-workflow-card,.q1-detail-workflow-item,.q1-detail-panel") || heading.parentElement;
  };
  const updateWorkflowCards = () => {
    const cards = copyByTitle.map(([title, copy]) => {
      const card = findCard(title);
      if (!card) return null;
      const paragraphs = [...card.querySelectorAll("p")];
      const body = paragraphs.find(p => p !== card.querySelector("h1,h2,h3,h4"));
      if (body && body.textContent.trim() !== copy) body.textContent = copy;
      return card;
    });
    const tagList = document.querySelector("#q1-detail-points");
    if (tagList) {
      const hideTagList = Boolean(cards[0] && cards[1]);
      tagList.hidden = hideTagList;
      tagList.style.display = hideTagList ? "none" : "";
    }
    if (!cards[0] || !cards[1]) return;
    let container = cards[0].parentElement;
    while (container && !container.contains(cards[1])) container = container.parentElement;
    if (!container) return;
    Object.assign(container.style, {display:"grid", gridTemplateColumns:"repeat(2,minmax(0,1fr))", alignItems:"stretch", gap:"clamp(16px,2vw,28px)"});
    const psdStyle = getComputedStyle(cards[1]);
    const viTitle = document.querySelector("#q1-detail-point-title");
    const psdTitle = document.querySelector("#q1-detail-highlight-title");
    if (viTitle && psdTitle) {
      const titleStyle = getComputedStyle(psdTitle);
      Object.assign(viTitle.style, {fontFamily:titleStyle.fontFamily, fontSize:titleStyle.fontSize, fontWeight:titleStyle.fontWeight, lineHeight:titleStyle.lineHeight, letterSpacing:titleStyle.letterSpacing, color:titleStyle.color});
    }
    const bodyReference = cards[0].querySelector("p");
    if (bodyReference) {
      const bodyFontSize = getComputedStyle(bodyReference).fontSize;
      for (const card of cards) card.querySelectorAll("p").forEach(p => p.style.fontSize = bodyFontSize);
      const outsideCopy = document.querySelector("#q1-detail-lead");
      if (outsideCopy) outsideCopy.style.fontSize = bodyFontSize;
    }
    for (const card of cards) {
      Object.assign(card.style, {
        height:"100%", boxSizing:"border-box", background:psdStyle.background,
        borderColor:psdStyle.borderColor, borderStyle:psdStyle.borderStyle,
        borderWidth:psdStyle.borderWidth, borderRadius:psdStyle.borderRadius,
        color:psdStyle.color
      });
    }
  };
  const observer = new MutationObserver(updateWorkflowCards);
  const start = () => {
    updateWorkflowCards();
    observer.observe(document.body, {subtree:true, childList:true, characterData:true});
  };
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", start, {once:true});
  else start();
})();
</script>
