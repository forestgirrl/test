    <img src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=" style="width:100%; display:block; object-fit:contain; border-radius: var(--radius-lg) var(--radius-lg) 0 0; background:#111;">
